{
    "version": "{{VERSION}}",
    "description": "Local-first catalog for foster cats - no server, no account",
    "homepage": "https://github.com/paxel/cat-a-log",
    "license": "Apache-2.0 OR MIT",
    "url": "https://github.com/paxel/cat-a-log/releases/download/v{{VERSION}}/catlog-{{VERSION}}-windows-x86_64.zip",
    "hash": "{{SHA_WINDOWS_X86_64}}",
    "bin": "catlog.exe",
    "shortcuts": [
        [
            "catlog.exe",
            "cat(a)log"
        ]
    ],
    "post_install": [
        "reg add 'HKCU\\Software\\Classes\\.catsync' /ve /d 'catlog.catsync' /f | Out-Null",
        "reg add 'HKCU\\Software\\Classes\\catlog.catsync' /ve /d 'cat(a)log bundle' /f | Out-Null",
        "reg add 'HKCU\\Software\\Classes\\catlog.catsync\\shell\\open\\command' /ve /d \"\"\"$dir\\catlog.exe\"\" \"\"%1\"\"\" /f | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "reg delete 'HKCU\\Software\\Classes\\.catsync' /f 2>$null | Out-Null",
            "reg delete 'HKCU\\Software\\Classes\\catlog.catsync' /f 2>$null | Out-Null"
        ]
    },
    "checkver": {
        "github": "https://github.com/paxel/cat-a-log"
    },
    "autoupdate": {
        "url": "https://github.com/paxel/cat-a-log/releases/download/v$version/catlog-$version-windows-x86_64.zip"
    }
}
